{
  "name": "slba",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "docker compose up -d",
  "forwardPorts": [
    8000
  ],
  "secrets": {
    "POSTGRES_PASSWORD": {
      "description": "Password for the local Postgres container"
    },
    "REDIS_PASSWORD": {
      "description": "Password for the local Redis container"
    },
    "SLBA_LLM_API_KEY": {
      "description": "Hosted LLM API key (optional in Phase 0)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-playwright.playwright"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
