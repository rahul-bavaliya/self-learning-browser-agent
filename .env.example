# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Postgres (docker compose) ---
POSTGRES_USER=slba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=slba
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis (docker compose) ---
REDIS_PASSWORD=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- LLM provider (hosted first, behind a swappable interface) ---
SLBA_LLM_PROVIDER=nim                # nim | vllm | ollama | fake
SLBA_LLM_MODEL=
SLBA_LLM_API_KEY=
# API root such as http://localhost:8000/v1 (not .../chat/completions). Empty = NIM default.
SLBA_LLM_BASE_URL=
SLBA_LLM_TOOL_CHOICE=named           # named | required | auto
SLBA_LLM_MAX_TOKENS=1024
SLBA_LLM_TIMEOUT_S=60                # per attempt
SLBA_LLM_MAX_RETRIES=2
# US$ per million tokens, from your provider's pricing page. 0 = cost not tracked.
SLBA_LLM_PRICE_IN_PER_MTOK=0
SLBA_LLM_PRICE_OUT_PER_MTOK=0

# --- Browser / safety ---
SLBA_BROWSER_CHANNEL=chrome          # chrome | msedge
SLBA_BROWSER_HEADLESS=true
# Comma-separated hosts the agent may open. Local benchmark sites by default.
SLBA_DOMAIN_ALLOWLIST=localhost,127.0.0.1
# Where throwaway browser profiles are created. Never point this at a real profile.
SLBA_PROFILE_ROOT=.slba/profiles
# Max characters of accessibility snapshot sent to the model per step.
SLBA_OBSERVATION_MAX_CHARS=12000

# --- Run budgets: hitting any one ends the run as "aborted"
SLBA_MAX_STEPS=25
SLBA_MAX_SECONDS=300
SLBA_MAX_COST_PER_RUN=0.50           # only enforced when the prices above are set
SLBA_EVIDENCE_ROOT=.slba/evidence

# --- Tests ---
# Set to 1 in CI / on your dev machine to fail (not skip) when Chrome or Edge is missing.
SLBA_REQUIRE_ALL_BROWSERS=0

# Set to 1 in CI to fail (not skip) integration tests when Postgres is unreachable.
SLBA_REQUIRE_DB=0
